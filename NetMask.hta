<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>NetMask</title>
<HTA:APPLICATION ID="hta" APPLICATIONNAME="NetMask" BORDER="thin" CAPTION="no" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="no" SCROLL="no" CONTEXTMENU="no" SELECTION="no" ICON="netmask.ico" />
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#0E1014;color:#E6E9EF;font-family:"Segoe UI",sans-serif;font-size:14px;-ms-user-select:none;cursor:default}
#app{position:relative;height:100%;display:flex;flex-direction:column;border:1px solid #1D222C}
#bar{height:44px;flex:none;display:flex;align-items:center;padding:0 8px 0 18px}
#bar .logo{width:18px;height:18px;color:#7DA2E3;margin-right:10px}
#bar .t{flex:1;font-size:13px;font-weight:600;letter-spacing:.3px}
.wb{width:34px;height:30px;border:0;background:transparent;color:#778093;border-radius:8px;cursor:pointer;outline:0}
.wb:hover{background:#1A1F29;color:#E6E9EF}
.wb.x:hover{background:#3A1E24;color:#E88289}
#main{flex:1 1 0px;min-height:0;display:flex;flex-direction:column;padding:6px 20px 18px}
.hero{flex:none;padding:20px 20px 18px;border-radius:16px;border:1px solid #232A36;background:linear-gradient(160deg,#192030 0%,#12161D 72%)}
.state{display:flex;align-items:center;font-size:12px;color:#8A93A6}
.dot{width:7px;height:7px;border-radius:50%;background:#7DA2E3;margin-right:9px;animation:pulse 2.6s infinite}
.dot.off{background:#4A5262;animation:none}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(125,162,227,.5)}70%{box-shadow:0 0 0 8px rgba(125,162,227,0)}100%{box-shadow:0 0 0 0 rgba(125,162,227,0)}}
.big{font-size:32px;font-weight:300;letter-spacing:-.5px;margin:12px 0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.big.dim{color:#4A5262}
.real{font-size:12px;color:#778093}
.real b{color:#A9B2C3;font-weight:500}
#warn{display:none;flex:none;align-items:center;margin-top:12px;padding:9px 12px;border-radius:10px;background:rgba(224,164,88,.09);color:#E0B073;font-size:12px}
#warn span{flex:1}
#warn button{border:0;background:transparent;color:#F0C48A;font:600 12px "Segoe UI";cursor:pointer;outline:0}
.h{flex:none;display:flex;align-items:center;margin:22px 2px 10px;font-size:12px;color:#778093}
.h span{flex:1}
.ib{width:28px;height:28px;border:0;border-radius:8px;background:transparent;color:#778093;cursor:pointer;outline:0}
.ib:hover{background:#1A1F29;color:#E6E9EF}
#list{flex:1 1 0px;min-height:0;overflow-y:auto;-ms-overflow-style:none}
.row{display:flex;align-items:center;padding:10px 12px;margin-bottom:6px;border-radius:12px;border:1px solid transparent;background:#12161D;cursor:pointer;transition:background .15s,border-color .15s}
.row:hover{background:#161B24}
.row.sel{background:#151B27;border-color:rgba(125,162,227,.38)}
.row.in{animation:in .4s both}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.ri{flex:none;width:32px;height:32px;margin-right:12px;border-radius:9px;background:#1A1F29;color:#778093;display:flex;align-items:center;justify-content:center}
.row.sel .ri{color:#7DA2E3;background:rgba(125,162,227,.12)}
.rm{flex:1 1 0px;min-width:0}
.rn{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rs{font-size:11.5px;color:#778093;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tag{flex:none;margin-left:8px;padding:3px 9px;border-radius:20px;font-size:11px;color:#7DA2E3;background:rgba(125,162,227,.11)}
.empty{padding:26px 10px;text-align:center;color:#778093;font-size:13px;line-height:1.5}
.panel{flex:none;margin-top:12px;padding-top:16px;border-top:1px solid #1D222C}
.lbl{font-size:12px;color:#778093;margin:0 2px 8px}
#nn{width:100%;height:42px;padding:0 14px;border-radius:11px;border:1px solid #232A36;background:#0B0D11;color:#E6E9EF;font:15px "Segoe UI";outline:0;-ms-user-select:text;cursor:text;transition:border-color .15s}
#nn:focus{border-color:#7DA2E3}
.prev{display:flex;align-items:center;margin:10px 2px 14px;font-size:12px;color:#778093}
.prev svg{color:#7DA2E3;margin-right:8px;flex:none}
.prev b{color:#A9B2C3;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.btns{display:flex}
.btn{height:40px;padding:0 16px;border-radius:11px;border:1px solid #232A36;background:transparent;color:#A9B2C3;font:13px "Segoe UI";cursor:pointer;outline:0;margin-left:8px;transition:background .15s,border-color .15s}
.btn:hover{background:#161B24;border-color:#2F3848}
.btn.p{flex:1;margin-left:0;border-color:#7DA2E3;background:#7DA2E3;color:#0A1220;font-weight:600}
.btn.p:hover{background:#94B4EA;border-color:#94B4EA}
#toast{position:absolute;left:50%;bottom:92px;max-width:360px;padding:10px 16px;border-radius:11px;background:#1D2330;border:1px solid #2B3345;color:#E6E9EF;font-size:12.5px;opacity:0;transform:translateX(-50%) translateY(6px);transition:opacity .25s,transform .25s;pointer-events:none;white-space:nowrap}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.bad{border-color:#5A2B31;color:#F0A0A5}
</style>
<script language="JScript">
var sh = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var BASE = "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\NetworkList\\Profiles\\";
var DATA = sh.ExpandEnvironmentStrings("%ProgramData%") + "\\NetMask";
var BK = DATA + "\\names.txt";
var state = {nets: [], sel: -1, selGuid: null, conn: null, admin: false};
var WIFI = '<svg width="16" height="16" viewBox="0 0 24 24"><path d="M2 8.8a15 15 0 0 1 20 0M5 12.4a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="19.4" r="1.4" fill="currentColor"/></svg>';

function $(i){ return document.getElementById(i); }
function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function trim(s){ return String(s).replace(/^\s+|\s+$/g, ""); }

function run(cmd){
  var tmp = sh.ExpandEnvironmentStrings("%TEMP%") + "\\nm_" + new Date().getTime() + ".txt";
  sh.Run('cmd /c chcp 65001 >nul & ' + cmd + ' > "' + tmp + '" 2>&1', 0, true);
  var out = "";
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 2; st.Charset = "utf-8"; st.Open(); st.LoadFromFile(tmp); out = st.ReadText(); st.Close();
  } catch (e) {}
  try { fso.DeleteFile(tmp); } catch (e2) {}
  return out;
}

function readBackup(){
  var m = {};
  try {
    if (!fso.FileExists(BK)) return m;
    var f = fso.OpenTextFile(BK, 1, false, -1), t = f.ReadAll(); f.Close();
    var L = t.split("\n");
    for (var i = 0; i < L.length; i++) {
      var l = trim(L[i]), p = l.indexOf("|");
      if (p > 0) m[l.substring(0, p)] = l.substring(p + 1);
    }
  } catch (e) {}
  return m;
}

function writeBackup(m){
  try {
    if (!fso.FolderExists(DATA)) fso.CreateFolder(DATA);
    var any = false, s = "";
    for (var k in m) { s += k + "|" + m[k] + "\r\n"; any = true; }
    if (!any) { if (fso.FileExists(BK)) fso.DeleteFile(BK); return; }
    var f = fso.CreateTextFile(BK, true, true); f.Write(s); f.Close();
  } catch (e) {}
}

function getConn(){
  var o = run("netsh wlan show interfaces");
  var ssid = /^\s*SSID\s*:\s*(.+)$/m.exec(o);
  if (!ssid) return null;
  var prof = /^\s*Profile\s*:\s*(.+)$/m.exec(o);
  var sig = /^\s*Signal\s*:\s*(.+)$/m.exec(o);
  return {ssid: trim(ssid[1]), profile: prof ? trim(prof[1]) : trim(ssid[1]), signal: sig ? trim(sig[1]) : "", net: null};
}

function loadNets(){
  var bk = readBackup(), nets = [];
  var lines = run('reg query "' + BASE.slice(0, -1) + '"').split("\n");
  for (var i = 0; i < lines.length; i++) {
    var g = /\{[0-9A-Fa-f\-]+\}/.exec(lines[i]);
    if (!g) continue;
    var type, name;
    try { type = sh.RegRead(BASE + g[0] + "\\NameType"); name = sh.RegRead(BASE + g[0] + "\\ProfileName"); } catch (e) { continue; }
    if (type !== 71) continue;
    var orig = bk[g[0]] || name;
    nets.push({guid: g[0], name: name, orig: orig, renamed: orig !== name, live: false});
  }
  nets.sort(function(a, b){ return a.name.toLowerCase() < b.name.toLowerCase() ? -1 : 1; });
  var c = state.conn;
  if (c) for (var j = 0; j < nets.length; j++) {
    var n = nets[j];
    if (n.orig == c.profile || n.name == c.profile || n.orig == c.ssid || n.name == c.ssid) { n.live = true; c.net = n; break; }
  }
  state.nets = nets;
  state.sel = -1;
  for (var k = 0; k < nets.length; k++) if (nets[k].guid == state.selGuid) state.sel = k;
  if (state.sel < 0) for (var m = 0; m < nets.length; m++) if (nets[m].live) state.sel = m;
  if (state.sel < 0 && nets.length) state.sel = 0;
  state.selGuid = state.sel >= 0 ? nets[state.sel].guid : null;
}

function renderHero(){
  var c = state.conn, h = $("hero");
  if (!c) { h.innerHTML = '<div class="state"><span class="dot off"></span>Not connected</div><div class="big dim">No Wi-Fi</div><div class="real">Connect to a network and it will show up here.</div>'; return; }
  var shown = c.net ? c.net.name : c.ssid;
  var real = (c.net && c.net.name != c.ssid) ? 'Real network name: <b>' + esc(c.ssid) + '</b>' : 'Showing the real network name';
  if (c.signal) real += '&nbsp;&nbsp;&nbsp;Signal ' + esc(c.signal);
  h.innerHTML = '<div class="state"><span class="dot"></span>Connected</div><div class="big">' + esc(shown) + '</div><div class="real">' + real + '</div>';
}

function renderList(anim){
  var n = state.nets, s = "";
  $("count").innerHTML = n.length ? "Saved networks (" + n.length + ")" : "Saved networks";
  if (!n.length) { $("list").innerHTML = '<div class="empty">No saved Wi-Fi networks found.<br>Connect to a network once and it will appear here.</div>'; return; }
  for (var i = 0; i < n.length; i++) {
    var sub = n[i].renamed ? "Originally " + esc(n[i].orig) : "Original name";
    s += '<div class="row' + (i == state.sel ? ' sel' : '') + (anim ? ' in' : '') + '" style="animation-delay:' + (i * 45) + 'ms" onclick="pick(' + i + ')">' +
      '<div class="ri">' + WIFI + '</div><div class="rm"><div class="rn">' + esc(n[i].name) + '</div><div class="rs">' + sub + '</div></div>' +
      (n[i].live ? '<div class="tag">Connected</div>' : '') + '</div>';
  }
  $("list").innerHTML = s;
}

function render(anim){
  renderHero(); renderList(anim);
  $("warn").style.display = state.admin ? "none" : "flex";
  var n = state.nets[state.sel];
  $("nn").value = n ? n.name : "";
  preview();
}

function preview(){ $("pv").innerText = trim($("nn").value) || "Network name"; }

function pick(i){
  state.sel = i; state.selGuid = state.nets[i].guid;
  renderList(false);
  $("nn").value = state.nets[i].name; preview();
  $("nn").focus(); $("nn").select();
}

function refresh(anim){
  state.conn = getConn(); loadNets(); render(anim);
}

var tt = null;
function toast(msg, bad){
  var t = $("toast"); t.innerText = msg; t.className = bad ? "show bad" : "show";
  clearTimeout(tt); tt = setTimeout(function(){ t.className = ""; }, 3200);
}

function selNet(){
  var n = state.nets[state.sel];
  if (!n) toast("Select a network first.", true);
  return n;
}

function setName(n, v){
  if (!state.admin) { toast("Administrator access is required.", true); return false; }
  try { sh.RegWrite(BASE + n.guid + "\\ProfileName", v, "REG_SZ"); return true; }
  catch (e) { toast("Windows blocked the change. Try again as administrator.", true); return false; }
}

function applyName(){
  var n = selNet(); if (!n) return;
  var v = trim($("nn").value);
  if (!v) { toast("Type a display name first.", true); return; }
  if (v == n.name) { toast("That is already the display name."); return; }
  var bk = readBackup();
  if (!bk[n.guid]) { bk[n.guid] = n.name; writeBackup(bk); }
  if (setName(n, v)) { refresh(false); toast("Renamed to " + v + ". Reconnect to see it everywhere."); }
}

function restoreSel(){
  var n = selNet(); if (!n) return;
  var bk = readBackup();
  if (!bk[n.guid]) { toast("This network still has its original name."); return; }
  if (setName(n, bk[n.guid])) { delete bk[n.guid]; writeBackup(bk); refresh(false); toast("Original name restored."); }
}

function reconnect(){
  var c = state.conn;
  if (!c) { toast("You are not connected to Wi-Fi.", true); return; }
  toast("Reconnecting...");
  setTimeout(function(){
    run("netsh wlan disconnect");
    run('netsh wlan connect name="' + c.profile.replace(/"/g, "") + '"');
    setTimeout(function(){ refresh(false); toast("Reconnected."); }, 3500);
  }, 120);
}

function elevate(){
  var p = decodeURI(location.href).replace(/^file:\/+/i, "").replace(/\//g, "\\");
  new ActiveXObject("Shell.Application").ShellExecute("mshta.exe", '"' + p + '"', "", "runas", 1);
  window.close();
}

var drag = false, lx = 0, ly = 0;
function startDrag(){ var e = window.event; drag = true; lx = e.screenX; ly = e.screenY; $("bar").setCapture(); }
function moveDrag(){ if (!drag) return; var e = window.event; window.moveBy(e.screenX - lx, e.screenY - ly); lx = e.screenX; ly = e.screenY; }
function endDrag(){ drag = false; $("bar").releaseCapture(); }

window.onload = function(){
  var w = 440, h = Math.min(720, screen.availHeight - 40);
  window.resizeTo(w, h);
  window.moveTo(Math.round((screen.availWidth - w) / 2), Math.round((screen.availHeight - h) / 2));
  state.admin = (sh.Run("cmd /c fltmc >nul 2>&1", 0, true) === 0);
  refresh(true);
};
</script>
</head>
<body>
<div id="app">
  <div id="bar" onmousedown="startDrag()" onmousemove="moveDrag()" onmouseup="endDrag()">
    <svg class="logo" viewBox="0 0 24 24"><path d="M2 8.8a15 15 0 0 1 20 0M5 12.4a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="19.4" r="1.4" fill="currentColor"/></svg>
    <div class="t">NetMask</div>
    <button class="wb" onmousedown="event.cancelBubble=true" onclick="hta.windowState='minimize'"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 6h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
    <button class="wb x" onmousedown="event.cancelBubble=true" onclick="window.close()"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
  </div>
  <div id="main">
    <div class="hero" id="hero"></div>
    <div id="warn"><span>Renaming needs administrator access.</span><button onclick="elevate()">Grant access</button></div>
    <div class="h"><span id="count">Saved networks</span>
      <button class="ib" title="Refresh" onclick="refresh(false)"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div id="list"></div>
    <div class="panel">
      <div class="lbl">Display name</div>
      <input id="nn" type="text" maxlength="60" spellcheck="false" onkeyup="preview(); if(event.keyCode==13) applyName();">
      <div class="prev"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M2 8.8a15 15 0 0 1 20 0M5 12.4a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="19.4" r="1.4" fill="currentColor"/></svg>Windows will show&nbsp;<b id="pv"></b></div>
      <div class="btns">
        <button class="btn p" onclick="applyName()">Apply name</button>
        <button class="btn" onclick="restoreSel()">Restore</button>
        <button class="btn" onclick="reconnect()">Reconnect</button>
      </div>
    </div>
  </div>
  <div id="toast"></div>
</div>
</body>
</html>
