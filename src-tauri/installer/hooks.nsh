; Branding and readable welcome copy. Uses Tauri's standard native installer flow.
!ifndef MUI_WELCOMEPAGE_TITLE
  !define MUI_WELCOMEPAGE_TITLE "Welcome to NetMask"
!endif
!ifndef MUI_WELCOMEPAGE_TEXT
