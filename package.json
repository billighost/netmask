{
  "name": "netmask",
  "version": "2.3.4",
  "description": "Cross-platform local network display name manager for Windows, macOS, and Linux",
  "author": {
    "name": "Bello Bilal",
    "email": "bb2010ng@gmail.com",
    "url": "https://github.com/billighost"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/billighost/netmask.git"
  },
  "homepage": "https://github.com/billighost/netmask#readme",
  "bugs": {
    "url": "https://github.com/billighost/netmask/issues"
  },
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis,msi",
    "dist:mac": "tauri build --bundles dmg",
    "dist:linux": "tauri build --bundles deb,appimage",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-hooks.js",
    "test": "node --test scripts/frontend.test.cjs scripts/hooks.test.cjs scripts/release.test.cjs scripts/test-verification.js",
    "test:ui": "node scripts/verify-ui.cjs",
    "benchmark:ui": "node scripts/benchmark-ui.cjs",
    "benchmark:memory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-memory.ps1",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --workspace --locked",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml --workspace --locked",
    "format:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "version:set": "node scripts/set-version.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.64.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.5"
  }
}
